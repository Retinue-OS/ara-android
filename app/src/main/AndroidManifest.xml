<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The web app, model downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The web app's voice input (granted to the configured origin only) and the wake phrase. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView opens the page's audio capture only when the app may also
         change audio settings; without it getUserMedia fails despite RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Wake mode "always": a foreground service of type microphone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The ongoing wake notification and the wake alert (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A wake heard in the background opens the shell through a full-screen
         notification (Android 14+: the user allows it in the system settings). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Optional, user-granted in system settings: lets a wake heard while
         another app is in front bring Ara forward directly. Without it Android
         10+ blocks the start and only the heads-up notification is shown. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Updates: Ara installs the APK it fetched from the release channel over
         itself (the user allows "Install unknown apps" for Ara once); with the
         second permission Android 12+ updates it without asking each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Health Connect sync (see health/HealthSyncRuntime): read-only, the user
         grants each type in Health Connect's own dialog; the data goes only to
         the configured Retinue origin. Background read where Health Connect
         offers it. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Optional, user-granted in the system settings (usage access): the
         tray orders apps by their last use however they were opened, not
         only by Ara's own launches. Only when the app was on screen is read. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Keyboard for other devices (keyboard/KeyboardRuntime): the phone as a
         Bluetooth HID keyboard. Connect to register and type, advertise to be
         discoverable for pairing; a connectedDevice foreground service keeps
         the registration while Ara is in the background. Asked for only when
         the user switches the keyboard on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Held while typing: a press whose release came after the phone slept
         would repeat on the other device. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility (Android 11+): the app drawer lists launchable apps,
         and launcher links resolve their handlers. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Health Connect as an app (Android 13 and lower; built in from 14). -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".AraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ara">

        <!-- The shell. MAIN/LAUNCHER for the app list; MAIN/HOME/DEFAULT so Android
             offers it as the default home app. singleTask: Home presses, launcher
             taps and wakes reach the one instance (onNewIntent). The config
             changes are handled in place so the WebView and its page survive
             rotation, resizing and theme switches. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Open this dashboard URL in the app" links (shell/ShellLinks):
                 retinue-shell://open?url=… from Chrome's intent:// links, and
                 the opaque retinue-shell:open?url=…. The URL loads only on the
                 configured origin. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="retinue-shell" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows this when the user asks why Ara wants health
             data: Android 13 and lower through the Health Connect app's action,
             Android 14+ through the alias below. Health Connect refuses to ask
             for permissions for an app without it. -->
        <activity
            android:name=".ui.HealthRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ara.Translucent"
            android:label="@string/health_rationale_title">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ui.HealthPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The shell's split-screen window (see SplitShellActivity): the home
             activity is always full screen, so a second activity in a task of its
             own (its own affinity) shows the same page in one half of the screen.
             Not exported: only Ara starts it, and Recents brings it back. The same
             config changes are handled in place, as the shared WebView must
             survive them here too. -->
        <activity
            android:name=".ui.SplitShellActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.split"
            android:resizeableActivity="true"
            android:autoRemoveFromRecents="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale" />

        <!-- Pinned shortcuts (Chrome's "Install app" / "Add to home screen", other
             apps' shortcuts): ShortcutManager.requestPinShortcut() works only when
             the default home app has an activity for CONFIRM_PIN_SHORTCUT, which
             Android resolves within that package and starts explicitly. Its own
             empty task affinity keeps it from bringing the shell's task forward. -->
        <activity
            android:name=".ui.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ara.Translucent"
            android:label="@string/pin_shortcut_title">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Uninstalled apps leave the launcher bar. PACKAGE_FULLY_REMOVED is one of
             the broadcasts a manifest may still declare, so it also reaches Ara when
             it is not running; only the system sends it, and only for an app
             uninstalled with its data (not for an update, an archived app or one on
             storage that is not mounted). -->
        <receiver
            android:name=".launcher.PackageRemovedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Wake mode "always". Started only while the shell is in front. The
             short-service type is only for leaving cleanly when the microphone
             type is refused (see WakeService). -->
        <service
            android:name=".wake.WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone|shortService" />

        <!-- Keyboard for other devices: keeps the HID registration while Ara is
             in the background (see keyboard/KeyboardService). -->
        <service
            android:name=".keyboard.KeyboardService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|shortService" />

        <!-- The keyboard screen: pairing, layout, live typing. Not exported. -->
        <activity
            android:name=".ui.KeyboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/keyboard_title" />

        <!-- The secret path: a password typed into the connected device, never
             shown to the page. It opens in the shell's task; FLAG_SECURE (set
             in code) blanks it in Recents and screenshots. Not noHistory: a
             locked password manager shows its unlock screen over the dialog
             and hands the fill back to it afterwards, which a noHistory
             activity, finished once covered, would never get. configChanges:
             turning the phone (or any other change) must not recreate it and
             cancel what the user is filling in. -->
        <activity
            android:name=".ui.SecretTypeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|density|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|grammaticalGender"
            android:theme="@style/Theme.Ara.Translucent"
            android:windowSoftInputMode="stateAlwaysVisible" />

        <!-- The package installer reports the outcome of an update here (through
             a PendingIntent of Ara's own, so the receiver is not exported). -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />

        <!-- Files the page asks to view that the WebView cannot show (a PDF):
             a private copy in the cache, handed to the viewer app with a
             one-off read grant (see ShellDownloads). Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shell_files" />
        </provider>

    </application>

</manifest>

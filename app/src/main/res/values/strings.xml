<resources>
    <!-- App label. This is the name Bixby matches on "start Ara". -->
    <string name="app_name">Ara</string>

    <!-- State labels (also used as accessible status text, never icon-only). -->
    <string name="state_initializing">Initializing</string>
    <string name="state_inactive">Inactive</string>
    <string name="state_listening">Listening</string>
    <string name="state_recognizing">Recognizing speech</string>
    <string name="state_captured_decision">Awaiting Send or Discard</string>
    <string name="state_submitting">Submitting</string>
    <string name="state_waiting">Waiting for Retinue</string>
    <string name="state_answer_pending">Answer ready</string>
    <string name="state_speaking">Speaking</string>
    <string name="state_error">Error</string>

    <!-- Primary action labels. -->
    <string name="action_send">Send</string>
    <string name="action_discard">Discard</string>
    <string name="action_start_listening">Start listening</string>
    <string name="action_stop">Stop</string>
    <string name="action_retry">Retry</string>
    <string name="action_dismiss_error">Dismiss</string>

    <!-- Toggles (with content descriptions for accessibility). -->
    <string name="mic_toggle_on_desc">Continuous conversation enabled. Tap to disable.</string>
    <string name="mic_toggle_off_desc">Continuous conversation disabled. Tap to enable.</string>
    <string name="speaker_toggle_on_desc">Automatic playback enabled. Tap to disable.</string>
    <string name="speaker_toggle_off_desc">Automatic playback disabled. Tap to enable.</string>
    <string name="mic_toggle_label">Continuous conversation</string>
    <string name="speaker_toggle_label">Automatic playback</string>

    <!-- Section headings. -->
    <string name="label_prompt">Recognized prompt</string>
    <string name="label_answer">Answer</string>
    <string name="label_status">Status</string>
    <string name="label_privacy">Recognition</string>
    <string name="no_prompt_yet">No prompt yet.</string>
    <string name="no_answer_yet">No answer yet.</string>

    <!-- Privacy states. -->
    <string name="privacy_on_device">On-device recognition</string>
    <string name="privacy_cloud">Recognition may use a cloud service</string>
    <string name="privacy_unknown">Recognition mode unknown</string>

    <!-- Cloud disclosure. -->
    <string name="cloud_disclosure_title">Speech recognition</string>
    <string name="cloud_disclosure_body">On-device recognition is not available for your language on this device, so Ara will use Android\'s speech-recognition service. Captured speech may be transmitted to the configured speech-recognition provider (for example, Google) for transcription. This happens only while you are speaking to Ara.</string>
    <string name="cloud_disclosure_accept">Continue</string>
    <string name="cloud_disclosure_decline">Not now</string>

    <!-- Captured-input decision dialog. -->
    <string name="captured_title">Use captured input?</string>
    <string name="captured_body">Speech has already been captured. Send it as a prompt or discard it?</string>

    <!-- Status / error messages. -->
    <string name="msg_no_speech">No speech detected.</string>
    <string name="msg_empty_prompt">Nothing was recognized, so there is nothing to send.</string>
    <string name="msg_recognizer_busy">The speech recognizer is busy. Retrying shortly.</string>
    <string name="msg_recognizer_unavailable">Speech recognition is not available on this device.</string>
    <string name="msg_recognition_failed">Recognition failed. Retrying shortly.</string>
    <string name="msg_network_recognition">A network error interrupted recognition.</string>
    <string name="msg_mic_permission_denied">Microphone permission is denied. Ara can still show answers and settings, but cannot listen. Grant the permission to speak to Ara.</string>
    <string name="msg_notif_permission_denied">Notification permission is denied. Ara works normally in the foreground, but cannot alert you when a background answer is ready.</string>
    <string name="msg_cloud_declined">Cloud recognition was declined, so Ara cannot listen. You can change this later.</string>
    <string name="msg_no_certificate">No client certificate is selected. Choose one in Settings to reach Retinue.</string>
    <string name="msg_cert_unavailable">The selected client certificate could not be used (it may have been removed or expired). Select another in Settings.</string>
    <string name="msg_tls_failed">Secure connection to Retinue failed. Check the endpoint and your client certificate.</string>
    <string name="msg_bad_job_uri">Retinue returned an invalid job reference.</string>
    <string name="msg_job_failed">Retinue could not complete the request.</string>
    <string name="msg_job_timeout">The request timed out before Retinue answered.</string>
    <string name="msg_submit_failed">Could not reach Retinue to submit the prompt.</string>
    <string name="msg_tts_failed">Text-to-speech is unavailable, so the answer is shown as text only.</string>
    <string name="msg_service_failed">Background polling could not start; keeping Ara in the foreground.</string>
    <string name="msg_blocked">Retinue refused the request: this identity is not authorized.</string>

    <!-- Notifications. -->
    <string name="notif_channel_name">Ara job activity</string>
    <string name="notif_channel_desc">Ongoing status while Ara waits for a Retinue answer, and a privacy-safe alert when the answer is ready.</string>
    <string name="notif_waiting_title">Ara is waiting for an answer</string>
    <string name="notif_waiting_body">Retinue is working on your request.</string>
    <string name="notif_answer_title">Ara has an answer</string>
    <string name="notif_answer_body">Tap to open Ara and see the answer.</string>
    <string name="notif_cancel">Cancel</string>


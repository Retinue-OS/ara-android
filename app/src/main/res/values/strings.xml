    <string name="settings_title">Settings</string>
    <string name="settings_open">Open settings</string>
    <string name="settings_base_url">Retinue base URL</string>
    <string name="settings_base_url_hint">https://agents.example.com</string>
    <string name="settings_message_path">Message path</string>
    <string name="settings_poll_interval">Initial poll interval (seconds)</string>
    <string name="settings_request_timeout">Network request timeout (seconds)</string>
    <string name="settings_job_timeout">Overall job timeout (seconds)</string>
    <string name="settings_max_retries">Consecutive poll retries before giving up</string>
    <string name="settings_speech_section">Speech recognition</string>
    <string name="settings_auto_end_of_speech">Auto-send at end of speech</string>
    <string name="settings_auto_end_of_speech_desc">When on, Ara sends automatically after you stop speaking. Turn off to keep listening through pauses; nothing is sent until you press Send.</string>
    <string name="settings_silence_timeout">End-of-speech pause (seconds, 0 = default)</string>
    <string name="settings_silence_timeout_desc">How long a pause may last before Ara assumes you have finished. Leave empty or 0 to use the recognizer\'s default.</string>
    <string name="settings_certificate">Client certificate</string>
    <string name="settings_certificate_none">None selected</string>
    <string name="settings_select_certificate">Select certificate</string>
    <string name="settings_clear_certificate">Clear</string>
    <string name="settings_save">Save</string>
    <string name="settings_close">Close</string>
</resources>
